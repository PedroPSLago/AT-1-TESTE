        {
          "name": "POST - Medicamento Duplicado (CT08)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{content_type}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \"nome\": \"Paracetamol\",\\n  \"dosagem\": \"500mg\",\\n  \"horario\": \"08:00\"\\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/medications",
              "host": ["{{base_url}}"],
              "path": ["api", "medications"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code é 409\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test(\"Mensagem de erro para duplicado\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.mensagem).to.include(\"já foi registrado\");",
                  "});",
                  "",
                  "pm.test(\"Código de erro correto\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.codigoErro).to.eql(\"MEDICAMENTO_DUPLICADO\");",
                  "});"
                ]
              }
            }
          ]
        }
